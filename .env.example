# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_MODULE_ID=userdata-local

# Module listen addresses
# USERDATA_LOCAL_GRPC_ADDR=:9703
# USERDATA_LOCAL_HTTP_ADDR=:9701

# SQLite database path (per-user blobs)
# USERDATA_LOCAL_DB_PATH=~/.muxcore/userdata.db
