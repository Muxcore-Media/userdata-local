# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_MODULE_ID=userdata-local

# Module listen addresses
# USERDATA_LOCAL_GRPC_ADDR=:9703
# USERDATA_LOCAL_HTTP_ADDR=:9701

# SQLite database path (per-user blobs)
# USERDATA_LOCAL_DB_PATH=~/.muxcore/userdata.db

# auth-local gRPC address for session validation
# AUTH_LOCAL_GRPC_ADDR=localhost:9403

# TLS (production) — see SECURITY.md
# MUXCORE_TLS_CERT=~/.muxcore/tls/userdata-local/client.crt
# MUXCORE_TLS_KEY=~/.muxcore/tls/userdata-local/client.key
# MUXCORE_TLS_CA=~/.muxcore/tls/userdata-local/ca.crt
# USERDATA_TLS_CERT=...
# USERDATA_TLS_KEY=...
# USERDATA_TLS_CA=...

# Dev only — plaintext gRPC (do not use in production)
# MUXCORE_INSECURE_DISABLE_TLS=true
